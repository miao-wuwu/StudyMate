# StudyMate AI 模块配置示例
# 复制为 .env 后按需修改；默认值即可在本机零成本运行（全部走本地 Ollama）

# 推理服务：ollama（本地，默认） 或 deepseek（云端，需要 API Key）
LLM_PROVIDER=ollama

# 本地 Ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=studymate-qwen
OLLAMA_EMBED_MODEL=nomic-embed-text

# 生成参数
NUM_CTX=4096
TEMPERATURE=0.3
# 模型空闲多久后卸载（0=立刻卸载，-1=常驻），用于控制显存占用
KEEP_ALIVE=5m
REQUEST_TIMEOUT=120

# 多轮对话历史裁剪：超过预算就丢弃更早的对话，避免撑爆 num_ctx
LLM_HISTORY_MAX_CHARS=6000
LLM_HISTORY_MAX_MESSAGES=20

# 检索参数
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=4

# 云端 DeepSeek（LLM_PROVIDER=deepseek 时生效，切勿提交到仓库）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
